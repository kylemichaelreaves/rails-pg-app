{
  "compilerOptions": {
    "declaration": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "sourceMap": true,
    "target": "ESNext",
    "jsx": "react-jsx",
    "noEmit": true,
    "allowJs": true,
    "outDir": "./dist/",
    "noImplicitAny": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "~/*": [
        "./app/javascript/*"
      ],
      "@/*": [
        "./app/javascript/*"
      ]
    }
  },
  "include": [
    "app/javascript/**/*"
  ],
  "exclude": [
    "app/assets",
    "app/controllers",
    "app/helpers",
    "app/jobs",
    "app/mailers",
    "app/models",
    ".bundle",
    ".idea",
    "gems",
    "config",
    "**/*.spec.ts",
    "node_modules",
    "test",
    "spec",
    "tmp",
    "db",
    "bin",
    "vendor",
    "public",
    "react-query/types/devtools"
  ],
  "compileOnSave": false
}